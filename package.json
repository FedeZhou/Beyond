{
  "name": "beyond-website",
  "private": true,
  "description": "Beyond website. No build step for the site itself; this file only holds the test tools (see tests/TESTPLAN.md).",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "npm run test:static && npm run test:unit && npm run test:frontend",
    "test:static": "node --test --test-reporter=spec \"tests/static/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec --experimental-strip-types --experimental-test-module-mocks --no-warnings --test-concurrency=1 \"tests/unit/*.test.mjs\"",
    "test:frontend": "node --test --test-reporter=spec --test-concurrency=2 \"tests/frontend/*.test.mjs\"",
    "test:smoke": "node --test --test-reporter=spec \"tests/smoke/*.test.mjs\"",
    "test:integration": "node tests/integration/run.mjs",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4",
    "playwright-core": "1.48.2"
  }
}
